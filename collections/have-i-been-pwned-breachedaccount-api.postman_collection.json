        {
          "id": "84a95897-efd1-4909-851c-23043265a47f",
          "name": "Get all breaches for an account",
          "request": {
            "name": "Get all breaches for an account",
            "description": {
              "content": "Available on Core, Pro, and High RPM subscriptions. Returns the breaches for the supplied account (email address, username, or phone number). The account is not case-sensitive and is trimmed of leading or trailing whitespace. The account should always be URL encoded. This is an authenticated API requiring both the hibp-api-key and user-agent headers. Test API keys can be used to query test accounts on the hibp-integration-tests.com domain.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "breachedaccount",
                ":account"
              ],
              "host": [
                "{{breachedaccount-account-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "truncateResponse",
                  "value": "true",
                  "description": "Returns the full breach model when false. By default, only the name of the breach is returned rather than the complete breach data."
                },
                {
                  "disabled": false,
                  "key": "domain",
                  "value": "<string>",
                  "description": "Filters the result set to only breaches against the domain specified. It is possible that one site (and consequently domain), is compromised on multiple occasions."
                },
                {
                  "disabled": false,
                  "key": "includeUnverified",
                  "value": "true",
                  "description": "Returns breaches that have been flagged as 'unverified'. By default, both verified and unverified breaches are returned when performing a search."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account",
                  "description": "(Required) URL-encoded account to search for (email address, username, or phone number)"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) User agent string identifying the consuming application. Required on all documented requests, including unauthenticated endpoints; missing user agents may receive HTTP 403 responses.",
                "key": "user-agent",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "hibp-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
