                "name": "user-agent",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Unique breach name (Pascal-cased, stable identifier)"
              }
            ]
          },
          "docs": "Returns the full breach model for a single breach identified by its stable Name value. This endpoint is unauthenticated, but it still requires a user-agent header."
