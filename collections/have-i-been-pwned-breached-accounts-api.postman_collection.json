        {
          "id": "1d324074-1a0e-40cf-abdf-f229ccb52d33",
          "name": "Get Breaches For An Account",
          "request": {
            "name": "Get Breaches For An Account",
            "description": {
              "content": "Returns all breaches for the supplied email address. Requires a valid `hibp-api-key`\nand a descriptive `user-agent` header.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "breachedaccount",
                ":account"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "truncateResponse",
                  "value": "true",
                  "description": "When true (default) only breach names are returned. Set false for full breach objects."
                },
                {
                  "disabled": false,
                  "key": "domain",
                  "value": "<string>",
                  "description": "Filter results to breaches against the supplied domain."
                },
                {
                  "disabled": false,
                  "key": "IncludeUnverified",
                  "value": "true",
                  "description": "When true (default), unverified breaches are included in results."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<email>",
                  "key": "account",
                  "description": "(Required) URL-encoded email address to search."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
