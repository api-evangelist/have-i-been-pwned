          "id": "d11f3814-50cb-4175-afc6-edadd21ef7d1",
          "name": "Get Breaches By K-Anonymity Range",
          "request": {
            "name": "Get Breaches By K-Anonymity Range",
            "description": {
              "content": "Returns email-account breach matches using a k-anonymity model. Supply the first six\ncharacters of the SHA-1 hash of the email address. Available on Pwned 2 and higher.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "breachedaccount",
                "range",
                ":hashPrefix"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "hashPrefix",
                  "description": "(Required) First six characters of the SHA-1 hash of the email address (uppercase)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
