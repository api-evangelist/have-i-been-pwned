{
  "item": [
    {
      "id": "47241a3f-b29f-4ba3-a907-c95ee6c399a1",
      "name": "Range Search",
      "description": {
        "content": "K-anonymity range search for password hashes.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "fd076c15-16b1-4c55-8125-6470f86a3d9f",
          "name": "Search By Hash Range",
          "request": {
            "name": "Search By Hash Range",
            "description": {
              "content": "Returns suffixes of all SHA-1 (or NTLM) hashes that begin with the supplied 5-character\nprefix, alongside the number of times each hash was observed in breaches.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "range",
                ":hashPrefix"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "mode",
                  "value": "sha1",
                  "description": "Hash algorithm. Default is SHA-1; set `ntlm` for NTLM hashes."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "hashPrefix",
                  "description": "(Required) First 5 characters of the SHA-1 (or NTLM) password hash, uppercase hex."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "When `true`, the response is padded to 800-1,000 entries to mask the response size.",
                "key": "Add-Padding",
                "value": "<boolean>"
              },
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "e85d8420-4417-4fe8-8d81-dcfbc250db86",
              "name": "A newline-separated list of `HASHSUFFIX:COUNT` entries. The endpoint always returns\n200; absence of the queried suffix indicates the password is not known to HIBP.\n",
              "originalRequest": {
                "url": {
                  "path": [
                    "range",
                    ":hashPrefix"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "mode",
                      "value": "sha1"
                    }
                  ],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "hashPrefix",
                      "description": "(Required) First 5 characters of the SHA-1 (or NTLM) password hash, uppercase hex."
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "hibp-api-key",
                    "value": "<API Key>"
                  },
                  {
                    "disabled": false,
                    "description": "When `true`, the response is padded to 800-1,000 entries to mask the response size.",
                    "key": "Add-Padding",
                    "value": "<boolean>"
                  },
                  {
                    "key": "Accept",
                    "value": "text/plain"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/plain"
                }
              ],
              "body": "0018A45C4D1DEF81644B54AB7F969B88D65:1\n00D4F6E8FA6EECAD2A3AA415EEC418D38EC:2\n",
              "cookie": [],
              "_postman_previewlanguage": "text"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "type": "string",
      "value": "https://haveibeenpwned.com/api/v3",
      "key": "baseUrl"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "hibp-api-key"
      },
      {
        "key": "value",
        "value": "{{apiKey}}"
      },
      {
        "key": "in",
        "value": "header"
      }
    ]
  },
  "info": {
    "_postman_id": "1077d0cc-e13c-4927-a9f5-b90422f3f2dc",
    "name": "Have I Been Pwned API v3 Breached Accounts Range Search API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Have I Been Pwned (HIBP) API allows the list of pwned accounts (email addresses, domains,\npasswords, and stealer log entries) to be quickly searched via REST. Authenticated endpoints\nrequire an `hibp-api-key` header. All requests must send a `user-agent` header that accurately\nidentifies the consuming application. Subscriptions range from Pwned 1 to Pwned 5.\n\n\nContact Support:\n Name: Have I Been Pwned",
      "type": "text/plain"
    }
  }
}