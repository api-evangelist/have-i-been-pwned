  "info": {
    "_postman_id": "3af7c758-bb68-438f-b4e3-2ba1eecc18a0",
    "name": "Have I Been Pwned API v3 Breached Accounts Domain Search API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Have I Been Pwned (HIBP) API allows the list of pwned accounts (email addresses, domains,\npasswords, and stealer log entries) to be quickly searched via REST. Authenticated endpoints\nrequire an `hibp-api-key` header. All requests must send a `user-agent` header that accurately\nidentifies the consuming application. Subscriptions range from Pwned 1 to Pwned 5.\n\n\nContact Support:\n Name: Have I Been Pwned",
      "type": "text/plain"
    }
  }
}